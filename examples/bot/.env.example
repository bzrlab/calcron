DISCORD_TOKEN=
# Registers slash commands on one guild instantly; leave empty for global commands.
DISCORD_GUILD_ID=

CALCRON_URL=wss://calcron.bzr.lt/ws
# One-time application token from `npm run provision -- app <name>`.
CALCRON_TOKEN=
CALCRON_APP_ID=
# Optional. Enables `npm run provision` and the /calcron operator commands.
CALCRON_ADMIN_TOKEN=

MOD_CHANNEL_ID=
MOD_ROLE_ID=
VERIFY_CHANNEL_ID=
VERIFIED_ROLE_ID=
STANDUP_CHANNEL_ID=

# Go duration syntax.
TICKET_IDLE=24h
TICKET_GRACE=1h
VERIFY_TIMEOUT=24h
ALERT_COOLDOWN=15m

# Business calendar and daily standup start schedule.
CALENDAR_TIMEZONE=Asia/Dhaka
# 0=Sunday … 6=Saturday
CALENDAR_WEEKDAYS=0,1,2,3,4
STANDUP_TIME=10:00
STANDUP_WINDOW=4h
# skip | run_once_late | catch_up
STANDUP_MISSED_POLICY=run_once_late
