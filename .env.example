# URL-safe only (embedded in DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32
CALCRON_ADMIN_TOKEN=
CALCRON_RETRY_BASE=1s

# Maximum JSON data/chain bytes; command envelope allows another 65536 bytes.
CALCRON_MAX_PAYLOAD_BYTES=65536
# Finished work and replay cache retention (Go duration; 720h = 30 days)
CALCRON_RETENTION=720h
